    { "id": "P3", "status": "agreed", "case": "Union[int, float] given 2.5", "method": "take_int_or_float", "annotation": "Union[int, float]", "typed": "2.5", "surface": "both", "expect": { "value": "2.5" } },
    { "id": "P4", "status": "agreed", "case": "Union[int, float] given 3 is an int", "method": "take_int_or_float", "annotation": "Union[int, float]", "typed": "3", "surface": "both", "expect": { "value": "3" } },
