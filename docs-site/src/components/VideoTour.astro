---
// The narrated tutorial (docs-site/video/), with its chapters as buttons that jump to them. The
// film, its captions and its poster are in public/video/, copied from video/out/ after a render.
interface Props {
  chapters: { at: number; title: string }[];
}
const { chapters } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---

<figure class="video-tour">
  <video controls preload="metadata" poster={`${base}/video/ivoryos-tutorial.jpg`}>
    <source src={`${base}/video/ivoryos-tutorial.mp4`} type="video/mp4" />
    <track kind="captions" srclang="en" label="English" src={`${base}/video/ivoryos-tutorial.vtt`} />
  </video>
  <ol>
    {chapters.map((chapter) => (
      <li>
        <button type="button" data-seek={chapter.at}>
          <span>{clock(chapter.at)}</span> {chapter.title}
        </button>
      </li>
    ))}
  </ol>
</figure>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.video-tour button[data-seek]');
    const video = button?.closest('.video-tour')?.querySelector('video');
    if (!button || !video) return;
    video.currentTime = Number(button.dataset.seek);
    void video.play();
  });
</script>

<style>
  .video-tour {
    margin-block: 1.5rem;
  }
  .video-tour video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: #fff;
  }
  .video-tour ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .video-tour li {
    margin: 0;
  }
  .video-tour button {
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .video-tour button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .video-tour button span {
    color: var(--sl-color-accent);
    font-variant-numeric: tabular-nums;
    margin-inline-end: 0.3rem;
  }
</style>
