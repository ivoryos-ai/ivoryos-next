{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "edge-server-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export IVORYOS_PORT=${PORT:-8080}; if [ \"$IVORYOS_PORT\" != 8080 ]; then export IVORYOS_DATA_DIR=\"${TMPDIR:-/tmp}/ivoryos-demo-$IVORYOS_PORT\"; [ -d \"$IVORYOS_DATA_DIR/workflows\" ] || { mkdir -p \"$IVORYOS_DATA_DIR\" && cp -R edge_server/ivoryos_edge/workflows \"$IVORYOS_DATA_DIR/workflows\"; }; fi; exec uv run --project edge_server python example/demo.py"
      ],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "liquid-handler-demo",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "edge_server",
        "--with-editable",
        "../IvoryOS-PyLabRobot-Integration",
        "python",
        "example/liquid_handler/demo.py"
      ],
      "port": 8083,
      "autoPort": false
    },
    {
      "name": "flow-pump-edge",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "edge_server",
        "python",
        "example/flow_lab/pump_edge.py"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "flow-collector-edge",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "edge_server",
        "python",
        "example/flow_lab/collector_edge.py"
      ],
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "core-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "cloud-frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "cloud_frontend/scripts/run-all.js",
        "dev",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "hub",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Users/User/landing-page-supabase",
        "run",
        "dev",
        "--",
        "-p",
        "3111"
      ],
      "port": 3111
    },
    {
      "name": "docs-deck",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "edge_server",
        "--with",
        "baybe==0.15.0",
        "--with",
        "plotly",
        "python",
        "docs-site/scripts/docs-deck.py"
      ],
      "port": 8090,
      "autoPort": false
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "docs-site",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    }
  ]
}
